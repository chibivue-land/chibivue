{
  "name": "chibivue",
  "version": "1.1.0",
  "license": "MIT",
  "author": "ubugeeei",
  "type": "module",
  "scripts": {
    "dev": "vp run book:dev",
    "build": "vp run book:build",
    "preview": "vp run book:preview",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "lint:text": "vp run text:lint",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "check": "vp run verify:static",
    "check:types": "vp run types",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "play": "vp run play:dev",
    "//": "",
    "setup": "vp install && vp run setup:dev",
    "setup:dev": "node --experimental-strip-types tools/chibivue-playground/main.ts",
    "setup:vue": "node --experimental-strip-types tools/vue-playground/main.ts",
    "setup:book": "node --experimental-strip-types tools/create-chibivue/main.ts",
    "count-chars": "node --experimental-strip-types tools/book-size/book/count-chars.ts",
    "translate": "node --experimental-strip-types tools/translator/ja2en/main.ts",
    "impl:dev": "vp run @chibivue/book-playground#dev",
    "impl:dev:app": "cd examples/app && vp dev",
    "impl:dev:vapor": "cd examples/vapor && vp dev",
    "impl:dev:vue": "cd examples/vuejs-core && vp install && vp run dev",
    "impl:build": "vp run impl:bundle",
    "impl:clean": "vp run impl:clean:dist",
    "impl:check": "vp run verify:impl",
    "impl:size": "tokei -f impl > tools/book-size/pkg/files.txt"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@monaco-editor/loader": "^1.7.0",
    "@webcontainer/api": "^1.6.4",
    "estree-walker": "^3.0.3",
    "magic-string": "^0.30.21",
    "monaco-editor": "^0.55.1",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@babel/types": "^7.29.7",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "chainsi": "^0.0.1",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5",
    "jsdom": "^29.1.1",
    "oxc-minify": "^0.135.0",
    "playwright": "^1.60.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.0",
    "rolldown-plugin-dts": "^0.25.2",
    "textlint": "^15.7.1",
    "textlint-rule-ja-space-between-half-and-full-width": "^3.0.0",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite-hyper-config": "^0.9.0",
    "vite-node": "^6.0.0",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.15",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "catalog:",
    "vue": "^3.5.35"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
